# Read-only RPC endpoints for block following and token-safety lookups. Never commit real values.
ALCHEMY_RPC_URL=
HELIUS_RPC_URL=
# Dashboard passcode; a one-off one is generated and printed at startup when unset.
TSOL_PASSCODE=
# Optional: replace the RPC pool, as "url=rps,url=rps".
TSOL_RPC_SPECS=
